# ── Frontend Configuration (Vite Build Environment) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend Configuration (Serverless / Sync Worker Environment) ──
# Service role key (server-side only — NEVER expose to the frontend)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Email Delivery Credentials (Resend API)
RESEND_API_KEY=your-resend-api-key-here

# Google Sheets Integration Web App URL
GOOGLE_SCRIPT_URL=your-google-script-url-here
